APP_NAME="Tawsili Logistics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Production (ethiodeploy) MUST use these values instead of the lines above:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://twsil.ethiodeploy.app
# ASSET_URL is not needed (leave unset); Trust Proxies + forceScheme handle HTTPS.

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=logistics_platform
DB_USERNAME=root
DB_PASSWORD=

# Cloud hosting (e.g. EthioDeploy) may expose MySQL only as a URL instead of
# the individual DB_* variables. Either form is supported; when a URL is set
# without DB_CONNECTION, the app defaults to the MySQL driver.
# DB_URL=mysql://user:password@host:3306/database
# DATABASE_URL=mysql://user:password@host:3306/database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="support@tawsili.test"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_TO_EMAIL=wkwk00466@gmail.com

# Stripe (test mode keys only)
STRIPE_KEY=
STRIPE_SECRET=

# Set before running `php artisan db:seed`; required to replace the development fallback.
ADMIN_PASSWORD=

APP_CURRENCY=SAR

# Google Maps JavaScript API key (optional; leave empty until provisioned)
GOOGLE_MAPS_API_KEY=

# AI provider: gemini or openai. Keep all provider keys server-side.
AI_PROVIDER=gemini

# OpenAI API key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
